{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node dist/index.js",
    "prebuild": "echo 'Preparing build...'",
    "build": "rm -rf dist && node ./node_modules/typescript/bin/tsc -p .",
    "dev": "node ./node_modules/nodemon/bin/nodemon.js",
    "migrate:up": "ts-node src/scripts/migrate.ts up",
    "migrate:up:prod": "node dist/scripts/migrate.js up",
    "migrate:status": "ts-node src/scripts/migrate.ts status",
    "migrate:status:prod": "node dist/scripts/migrate.js status",
    "seed:report": "ts-node src/scripts/seedReportData.ts",
    "test:report-import-parser": "node ./node_modules/ts-node/dist/bin.js src/scripts/testReportImportParser.ts"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.16.1",
    "bcryptjs": "3.0.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "exceljs": "4.4.0",
    "express": "4.22.2",
    "jsonwebtoken": "9.0.2",
    "jwks-rsa": "3.2.0",
    "jwt-decode": "4.0.0",
    "multer": "1.4.5-lts.2",
    "nanoid": "5.1.5",
    "nodemailer": "^8.0.9",
    "pg": "8.14.1",
    "sequelize": "6.37.8"
  },
  "devDependencies": {
    "@types/express": "5.0.1",
    "@types/multer": "^1.4.12",
    "@types/node": "22.13.12",
    "@types/nodemailer": "^8.0.0",
    "@types/sequelize": "4.28.20",
    "nodemon": "3.1.9",
    "ts-node": "10.9.2",
    "typescript": "5.8.2"
  }
}
